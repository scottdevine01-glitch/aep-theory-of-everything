def create_ascii_chart():
    """Create simple ASCII bar chart for complexity visualization"""
    print("\n" + "="*60)
    print("COMPLEXITY MINIMIZATION VISUALIZATION")
    print("="*60)
    
    theories = ['Too Simple', 'AEP Optimal', 'Overfit']
    total_comp = [80, 70, 85]  # Simplified for ASCII
    
    print("\nTotal Descriptive Complexity by Theory:")
    print("-" * 50)
    
    for i, theory in enumerate(theories):
        bars = '█' * (total_comp[i] // 2)
        if theory == 'AEP Optimal':
            marker = ' ← MINIMUM'
        else:
            marker = ''
        print(f"{theory:12}: {bars} {total_comp[i]} bits{marker}")
    
    print("-" * 50)
    print("AEP selects the theory with minimum total complexity")

